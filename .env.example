# ===== 서울 열린데이터광장 =====
# https://data.seoul.go.kr 에서 무료 인증키 발급 (OA-2266 체육시설 공공서비스예약 정보)
SEOUL_API_KEY=your_seoul_open_api_key
SEOUL_API_BASE=http://openapi.seoul.go.kr:8088
SEOUL_SERVICE_NAME=ListPublicReservationSport

# ===== 카카오 나에게 보내기 =====
# https://developers.kakao.com 앱 → REST API 키, talk_message 동의 후 토큰 발급
KAKAO_REST_KEY=your_kakao_rest_api_key
KAKAO_REFRESH_TOKEN=your_kakao_refresh_token
KAKAO_ACCESS_TOKEN=

# ===== 멀티소스 설정 =====
# 활성 수집 소스 (CSV, 비우면 공식 오픈API만). opt-in 소스(자치구 HTML)는 여기 명시해야만 동작.
# 예: "seoul_open_api,gangnam"  (강남은 파서 검증 후에만 켤 것 — probe_gangnam.py 참고)
ENABLED_SOURCES=
# Tier 2~3(HTML) 저빈도 크롤링 매너
CRAWL_USER_AGENT=SeoulTennisAlert/1.0 (personal use; contact: dongil0105@gmail.com)
CRAWL_CACHE_MINUTES=10

# ===== 동작 설정 =====
POLL_INTERVAL_MINUTES=7
TIER2_INTERVAL_MINUTES=20
BATCH_MAX=10
ALLOW_REOPEN_ALERT=false
# 무음 시간대 (KST 기준, 이 사이엔 발송 안 함). 형식: "23-06". 비우면 항상 발송.
QUIET_HOURS=23-06
# 하루 알림 '슬롯' 총량 상한 (KST 자정 리셋, 0=무제한). 슬롯 수 기준이며 메시지 수가 아님.
DAILY_SEND_LIMIT=50

# ===== 저장소 =====
DB_URL=sqlite:///./data/app.db
